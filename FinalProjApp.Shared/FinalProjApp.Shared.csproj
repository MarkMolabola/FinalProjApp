<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Everything both apps show: pages, layouts, CSS, images, models and the
    service interfaces the pages talk to. FinalProjApp (MAUI) and
    FinalProjApp.Web each plug in their own implementations.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FinalProjApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
    <PackageReference Include="Syncfusion.Blazor" Version="31.1.23" />
  </ItemGroup>

</Project>
