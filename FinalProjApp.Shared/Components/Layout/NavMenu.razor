@implements IDisposable
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IScheduleRequestService Requests

<nav class="bottom-nav">
    <NavLink class="bottom-nav-item" href="" Match="NavLinkMatch.All">
        <i class="bi bi-house-heart-fill"></i>
        <span>Home</span>
    </NavLink>

    <AuthorizeView Roles="Parent">
        <Authorized>
            <NavLink class="bottom-nav-item" href="/parent-portal">
                <i class="bi bi-balloon-heart-fill"></i>
                <span>My Kids</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Staff">
        <Authorized>
            <NavLink class="bottom-nav-item" href="Calendar">
                <i class="bi bi-calendar-heart-fill"></i>
                <span>Calendar</span>
            </NavLink>
            <NavLink class="bottom-nav-item" href="AddSchedule">
                <i class="bi bi-clock-fill"></i>
                <span>Schedule</span>
                @if (_pendingRequests > 0)
                {
                    <span class="nav-badge" aria-label="@(_pendingRequests == 1 ? "1 schedule request waiting" : $"{_pendingRequests} schedule requests waiting")">@(_pendingRequests > 9 ? "9+" : _pendingRequests)</span>
                }
            </NavLink>
            <NavLink class="bottom-nav-item" href="AddNew">
                <i class="bi bi-people-fill"></i>
                <span>Kids</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <NavLink class="bottom-nav-item" href="photos">
        <i class="bi bi-images"></i>
        <span>Photos</span>
    </NavLink>

    <NavLink class="bottom-nav-item" href="/crew">
        <i class="bi bi-emoji-smile-fill"></i>
        <span>Crew</span>
    </NavLink>

    <NavLink class="bottom-nav-item" href="/contact">
        <i class="bi bi-chat-heart-fill"></i>
        <span>Contact</span>
    </NavLink>
</nav>

@code {
    private int _pendingRequests;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Requests.Reviewed += OnReviewed;
        await RefreshCountAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(RefreshCountAsync);

    private void OnReviewed() => _ = InvokeAsync(RefreshCountAsync);

    private async Task RefreshCountAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User.ToAppUser();
        try
        {
            _pendingRequests = user?.Role == "Admin" ? await Requests.CountPendingAsync(user) : 0;
        }
        catch (HttpRequestException)
        {
            return; // The phone is offline: keep showing the last count
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Requests.Reviewed -= OnReviewed;
    }
}
