@page "/contact"
@using System.ComponentModel.DataAnnotations
@using FinalProjApp.Models
@inject IContactService Messages

<div class="page-head">
    <div>
        <h1>Say hello 👋</h1>
        <p>Questions about enrollment, schedules or anything else? We'd love to hear from you.</p>
    </div>
</div>

<AuthorizeView Roles="Admin" Context="adminView">
    <Authorized>
        <FinalProjApp.Components.Shared.ContactInbox />
    </Authorized>
</AuthorizeView>

<div class="two-col">
    <div class="soft-card">
        <h3>Reach us directly</h3>
        <div class="list-stack">
            <a class="list-row clickable text-decoration-none" href="mailto:info@daycaredemo.com">
                <span class="bubble tint-coral"><i class="bi bi-envelope-heart-fill"></i></span>
                <div class="grow">
                    <div class="title">Email</div>
                    <div class="sub">info@daycaredemo.com</div>
                </div>
            </a>
            <a class="list-row clickable text-decoration-none" href="tel:+15551234567">
                <span class="bubble tint-mint"><i class="bi bi-telephone-fill"></i></span>
                <div class="grow">
                    <div class="title">Front desk</div>
                    <div class="sub">(555) 123-4567</div>
                </div>
            </a>
            <a class="list-row clickable text-decoration-none" href="tel:+15557654321">
                <span class="bubble tint-sky"><i class="bi bi-telephone-fill"></i></span>
                <div class="grow">
                    <div class="title">Director</div>
                    <div class="sub">(555) 765-4321</div>
                </div>
            </a>
            <div class="list-row">
                <span class="bubble tint-sun"><i class="bi bi-geo-alt-fill"></i></span>
                <div class="grow">
                    <div class="title">Visit us</div>
                    <div class="sub" style="white-space: normal;">123 Sunshine Lane, Long Beach, CA 90802</div>
                </div>
            </div>
        </div>
    </div>

    <div class="soft-card">
        <h3>Send a message</h3>

        @if (submitted)
        {
            <div class="alert alert-success d-flex align-items-center gap-2">
                <i class="bi bi-heart-fill"></i> Thank you! We'll get back to you soon.
            </div>
        }
        @if (error != null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="@contactForm" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Your name</label>
                <InputText class="form-control" @bind-Value="contactForm.Name" placeholder="Jane Doe" />
                <ValidationMessage For="@(() => contactForm.Name)" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="contactForm.Email" placeholder="you@example.com" />
                <ValidationMessage For="@(() => contactForm.Email)" />
            </div>

            <div class="form-group">
                <label>Message</label>
                <InputTextArea class="form-control" @bind-Value="contactForm.Message" rows="5" placeholder="How can we help?" />
                <ValidationMessage For="@(() => contactForm.Message)" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@sending">
                <i class="bi bi-send-fill me-1"></i>@(sending ? "Sending…" : "Send message")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private ContactForm contactForm = new();
    private bool submitted, sending;
    private string? error;

    private async Task HandleSubmit()
    {
        sending = true;
        submitted = false;
        error = null;
        try
        {
            await Messages.SendAsync(contactForm);
            submitted = true;
            contactForm = new();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "Can't reach Caly Bear right now. Please try again, or call us.";
        }
        finally
        {
            sending = false;
        }
    }
}
