@page "/"
@layout Layout.MainLayout
@using FinalProjApp.Models
@using FinalProjApp.Services
@inject AuthenticationStateProvider AuthState
@inject ICRUD<Child> ChildService
@inject ICRUD<Guardian> GuardianService
@inject ICRUD<ScheduleEvent> EventService

<div class="hello">
    <div class="eyebrow">@Greeting() @Weather()</div>
    <h1>@(_user is null ? "Welcome to Caly Bear!" : $"Hi, {DisplayName(_user.Email)}!")</h1>
</div>

@if (_isStaff)
{
    <div class="stat-grid">
        <div class="stat-card tint-coral">
            <i class="bi bi-people-fill fs-4"></i>
            <span class="value">@_kidCount</span>
            <span class="label">Kids enrolled</span>
        </div>
        <div class="stat-card tint-sky">
            <i class="bi bi-calendar-heart-fill fs-4"></i>
            <span class="value">@_today.Count</span>
            <span class="label">On today</span>
        </div>
        <div class="stat-card tint-mint">
            <i class="bi bi-car-front-fill fs-4"></i>
            <span class="value">@_today.Count(t => t.Event.NeedsPickup)</span>
            <span class="label">Pickups today</span>
        </div>
        <div class="stat-card tint-lilac">
            <i class="bi bi-house-heart-fill fs-4"></i>
            <span class="value">@_familyCount</span>
            <span class="label">Families</span>
        </div>
    </div>

    <div class="quick-actions">
        <NavLink class="quick-action" href="AddNew">
            <span class="bubble tint-coral"><i class="bi bi-person-plus-fill"></i></span>
            Add a kid
        </NavLink>
        <NavLink class="quick-action" href="AddSchedule">
            <span class="bubble tint-sun"><i class="bi bi-clock-fill"></i></span>
            New schedule
        </NavLink>
        <NavLink class="quick-action" href="Calendar">
            <span class="bubble tint-sky"><i class="bi bi-calendar-week-fill"></i></span>
            Calendar
        </NavLink>
    </div>

    <div class="soft-card">
        <div class="card-title-row">
            <h3>Today</h3>
            <span class="pill tint-sun">@DateTime.Today.ToString("ddd, MMM d")</span>
        </div>

        @if (_today.Count == 0)
        {
            <div class="empty-state">
                <span class="emoji">🌤️</span>
                Nothing scheduled today. Enjoy the calm!
            </div>
        }
        else
        {
            <div class="list-stack">
                @foreach (var item in _today)
                {
                    <div class="list-row">
                        <div class="timeline-time">
                            @item.Start.ToString("h:mm")
                            <small>@item.Start.ToString("tt")</small>
                        </div>
                        <span class="avatar @AvatarTint(item.Event.ChildId)">@ChildInitials(item.Event.ChildId)</span>
                        <div class="grow">
                            <div class="title">@ChildName(item.Event)</div>
                            <div class="sub">
                                until @item.End.ToString("h:mm tt")@(string.IsNullOrWhiteSpace(item.Event.Note) ? "" : $" · {item.Event.Note}")
                            </div>
                        </div>
                        @if (item.Event.NeedsPickup)
                        {
                            <span class="pill tint-sky"><i class="bi bi-car-front-fill"></i> Pickup</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="hero-card">
        <h2>Where little ones grow, play &amp; belong</h2>
        <p>Curiosity grows, friendships bloom, and every child feels at home.</p>
        <div class="d-flex flex-wrap gap-2">
            @if (_user?.Role == "Parent")
            {
                <NavLink href="/parent-portal" class="btn btn-primary">
                    <i class="bi bi-balloon-heart-fill me-1"></i>See my kids
                </NavLink>
            }
            else if (_user is null)
            {
                <NavLink href="/login" class="btn btn-primary">
                    <i class="bi bi-person-fill me-1"></i>Sign in
                </NavLink>
            }
            <NavLink href="/photos" class="btn btn-secondary">
                <i class="bi bi-images me-1"></i>Photo gallery
            </NavLink>
        </div>
        <span class="hero-bear"><img class="brand-face" src="_content/FinalProjApp.Shared/Images/caly-logo.svg" alt="" /></span>
    </div>
}

<div class="section-label">Why families choose us</div>
<div class="feature-grid">
    <div class="feature-card">
        <span class="bubble tint-coral"><i class="bi bi-heart-fill"></i></span>
        <div>
            <h4>Safe &amp; loving</h4>
            <p>We nurture every child with care, compassion, and attention.</p>
        </div>
    </div>
    <div class="feature-card">
        <span class="bubble tint-sun"><i class="bi bi-calendar-event-fill"></i></span>
        <div>
            <h4>A happy routine</h4>
            <p>Play, learning, meals and rest, with every day color-coded for clarity.</p>
        </div>
    </div>
    <div class="feature-card">
        <span class="bubble tint-mint"><i class="bi bi-emoji-smile-fill"></i></span>
        <div>
            <h4>Caring crew</h4>
            <p>Certified caregivers and educators who love what they do.</p>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Tints = { "tint-coral", "tint-mint", "tint-sky", "tint-sun", "tint-lilac" };

    private AppUser? _user;
    private bool _isStaff;
    private int _kidCount;
    private int _familyCount;
    private Dictionary<int, Child> _children = new();
    private List<(ScheduleEvent Event, DateTime Start, DateTime End)> _today = new();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthState.GetAuthenticationStateAsync()).User.ToAppUser();
        _isStaff = _user?.Role is "Admin" or "Staff";
        if (!_isStaff) return;

        try
        {
            var children = await ChildService.GetList() ?? new();
            _children = children.ToDictionary(c => c.ChildId);
            _kidCount = children.Count;
            _familyCount = (await GuardianService.GetList() ?? new()).Count;

            var events = await EventService.GetList() ?? new();
            _today = events
                .Where(e => ScheduleRules.OccursOn(e, DateTime.Today))
                .Select(e =>
                {
                    var (start, end) = ScheduleRules.On(e, DateTime.Today);
                    return (e, start, end);
                })
                .OrderBy(t => t.start)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
    }

    private static string Greeting() => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    private static string Weather() => DateTime.Now.Hour switch
    {
        < 12 => "☀️",
        < 17 => "🌤️",
        _ => "🌙"
    };

    /// <summary>"maria.lee@…" → "Maria".</summary>
    private static string DisplayName(string email)
    {
        var first = email.Split('@')[0].Split('.', '_', '-')[0];
        return first.Length == 0 ? "there" : char.ToUpperInvariant(first[0]) + first[1..];
    }

    private string ChildName(ScheduleEvent e) =>
        _children.TryGetValue(e.ChildId, out var c) ? $"{c.FirstName} {c.LastName}" : e.Subject;

    private string ChildInitials(int childId) =>
        _children.TryGetValue(childId, out var c)
            ? $"{c.FirstName.FirstOrDefault()}{c.LastName.FirstOrDefault()}".ToUpperInvariant()
            : "?";

    private static string AvatarTint(int childId) => Tints[Math.Abs(childId) % Tints.Length];
}
