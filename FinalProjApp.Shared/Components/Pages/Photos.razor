@page "/photos"
@* Photos of the kids are for signed-in families and staff only, on web and phone *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using FinalProjApp.Services
@inject IPhotoService PhotoService
@inject AuthenticationStateProvider AuthState

<div class="page-head">
    <div>
        <h1>Photo gallery</h1>
        <p>Little moments from our days together.</p>
    </div>
</div>

@* Only admins add photos; everyone else just looks *@
<AuthorizeView Roles="Admin">
    <label class="upload-drop">
        <span class="bubble bubble-lg tint-coral"><i class="bi bi-cloud-arrow-up-fill"></i></span>
        <span class="grow">
            <span class="title d-block">@(_uploading ? "Uploading…" : "Add photos")</span>
            <span class="sub d-block">Tap to choose one or more pictures</span>
        </span>
        <InputFile OnChange="HandleFileUpload" multiple accept="image/*" />
    </label>
</AuthorizeView>

@if (ImageUrls.Any())
{
    <div class="photo-grid">
        @foreach (var url in ImageUrls)
        {
            <img src="@url" class="photo-item" alt="" />
        }
    </div>
}
else
{
    <div class="soft-card mt-3">
        <div class="empty-state">
            <span class="emoji">📸</span>
            No photos yet. Check back soon!
        </div>
    </div>
}

@code {
    // Phone cameras take big pictures; 15 MB leaves headroom over the 500 KB default
    private const long MaxPhotoBytes = 15 * 1024 * 1024;

    private List<string> ImageUrls = new();
    private bool _uploading;

    protected override async Task OnInitializedAsync()
    {
        var photos = await PhotoService.GetAllAsync();

        ImageUrls = photos.Select(p =>
            $"data:{p.ContentType};base64,{Convert.ToBase64String(p.Data)}"
        ).ToList();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        // The upload box is admin-only, but check again in case someone gets here anyway
        if (!(await AuthState.GetAuthenticationStateAsync()).User.IsInRole("Admin")) return;

        _uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles())
            {
                using var stream = file.OpenReadStream(MaxPhotoBytes);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                var buffer = memory.ToArray();

                await PhotoService.AddAsync(file.Name, file.ContentType, buffer);

                ImageUrls.Insert(0, $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload error: {ex.Message}");
        }
        finally
        {
            _uploading = false;
        }
    }
}
