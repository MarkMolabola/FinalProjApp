@page "/photos"
@inject IPhotoService PhotoService
@inject AuthenticationStateProvider AuthState

@*
    Two albums: a public Showcase (what guests see, chosen by the admin) and the
    private Families album (signed-in parents and staff). Only admins add, move
    or delete photos.
*@

<div class="page-head">
    <div>
        @if (_isGuest)
        {
            <h1>A peek inside 🧸</h1>
            <p>A few favourite moments from our days at Caly Bear.</p>
        }
        else
        {
            <h1>Photo gallery</h1>
            <p>Little moments from our days together.</p>
        }
    </div>
</div>

@if (_isAdmin)
{
    <div class="album-tabs mb-3">
        <button type="button" class="album-tab @(!_showPublic ? "active" : "")" @onclick="() => ShowAlbum(false)">
            <i class="bi bi-house-heart-fill"></i> Families
            <small>signed-in parents &amp; staff</small>
        </button>
        <button type="button" class="album-tab @(_showPublic ? "active" : "")" @onclick="() => ShowAlbum(true)">
            <i class="bi bi-stars"></i> Showcase
            <small>public, for guests</small>
        </button>
    </div>

    <label class="upload-drop">
        <span class="bubble bubble-lg tint-coral"><i class="bi bi-cloud-arrow-up-fill"></i></span>
        <span class="grow">
            <span class="title d-block">@(_uploading ? "Uploading…" : $"Add photos to {(_showPublic ? "the Showcase" : "Families")}")</span>
            <span class="sub d-block">@(_showPublic ? "Anyone visiting the app will see these" : "Only signed-in parents and staff will see these")</span>
        </span>
        <InputFile OnChange="HandleFileUpload" multiple accept="image/*" />
    </label>
}

@if (_error != null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@if (_photos.Any())
{
    <div class="photo-grid">
        @foreach (var photo in _photos)
        {
            <div class="photo-tile">
                <img src="@Url(photo)" class="photo-item" alt="" />
                @if (_isAdmin)
                {
                    <div class="photo-actions">
                        <button type="button" class="icon-btn" title="@(photo.IsPublic ? "Move to Families (private)" : "Move to the public Showcase")"
                                @onclick="() => Move(photo)">
                            <i class="bi @(photo.IsPublic ? "bi-lock-fill" : "bi-stars")"></i>
                        </button>
                        <button type="button" class="icon-btn" title="Delete photo" @onclick="() => Delete(photo)">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="soft-card mt-3">
        <div class="empty-state">
            <span class="emoji">📸</span>
            @(_isAdmin
                ? (_showPublic ? "The Showcase is empty. Add a few photos guests can see." : "No family photos yet. Add the first one!")
                : "No photos yet. Check back soon!")
        </div>
    </div>
}

@if (_isGuest)
{
    <div class="soft-card mt-3 d-flex align-items-center gap-3">
        <span class="bubble tint-lilac"><i class="bi bi-lock-fill"></i></span>
        <div class="grow">
            <div class="fw-bold">Caly Bear family?</div>
            <div class="text-muted fw-semibold small">Sign in to see photos of your little ones.</div>
        </div>
        <NavLink href="/login?ReturnUrl=%2Fphotos" class="btn btn-primary btn-sm text-nowrap">Sign in</NavLink>
    </div>
}

@code {
    // Phone cameras take big pictures; 15 MB leaves headroom over the 500 KB default
    private const long MaxPhotoBytes = 15 * 1024 * 1024;

    private List<Photo> _photos = new();
    private bool _isGuest, _isAdmin, _showPublic, _uploading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isGuest = user.Identity?.IsAuthenticated != true;
        _isAdmin = user.IsInRole("Admin");
        _showPublic = _isGuest; // guests only ever see the Showcase
        await LoadAsync();
    }

    private async Task ShowAlbum(bool publicAlbum)
    {
        _showPublic = publicAlbum;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _photos = await PhotoService.GetAsync(_showPublic);
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't load photos. Check your connection and try again.";
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        // The upload box is admin-only, but check again in case someone gets here anyway
        if (!_isAdmin) return;

        _uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles())
            {
                using var stream = file.OpenReadStream(MaxPhotoBytes);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                _photos.Insert(0, await PhotoService.AddAsync(file.Name, file.ContentType, memory.ToArray(), _showPublic));
            }
        }
        catch (Exception ex) when (ex is IOException or HttpRequestException)
        {
            _error = "A photo couldn't be uploaded. Photos must be images under 15 MB.";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task Move(Photo photo)
    {
        if (!_isAdmin) return;
        await PhotoService.MoveAsync(photo.Id, !photo.IsPublic);
        _photos.Remove(photo); // it now belongs to the other album
    }

    private async Task Delete(Photo photo)
    {
        if (!_isAdmin) return;
        await PhotoService.DeleteAsync(photo.Id);
        _photos.Remove(photo);
    }

    private static string Url(Photo p) => $"data:{p.ContentType};base64,{Convert.ToBase64String(p.Data)}";
}
