@page "/login"
@layout Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject FinalProjApp.Services.IAuthService Auth
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div class="login-card">
    <NavLink href="/" class="back-link" Match="NavLinkMatch.All">
        <i class="bi bi-arrow-left"></i> Back to home
    </NavLink>

    <div class="login-header">
        <div class="brand-mark"><img src="_content/FinalProjApp.Shared/Images/caly-logo.svg" alt="" /></div>
        <h2>Caly Bear Child Care</h2>
        <p>Welcome back! Sign in to continue.</p>
    </div>

    <EditForm Model="@_model" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-emoji-frown-fill"></i>@_errorMessage
            </div>
        }

        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="_model.Email" class="form-control" placeholder="you@example.com" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <InputText @bind-Value="_model.Password" class="form-control" type="password" placeholder="Your password" />
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Sign in
        </button>
    </EditForm>
</div>

@code {
    /// <summary>Set by the "please sign in" redirect, so you end up where you were going.</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private LoginModel _model = new();
    private string _errorMessage = "";
    private bool _loading = false;

    protected override async Task OnInitializedAsync()
    {
        // If already logged in, skip login page
        var user = (await AuthState.GetAuthenticationStateAsync()).User.ToAppUser();
        if (user != null)
            Nav.NavigateTo(AuthClaims.LandingPage(user.Role));
    }

    private async Task HandleLogin()
    {
        _errorMessage = "";
        _loading = true;

        // On success this takes the user to their landing page
        var error = await Auth.SignInAsync(_model.Email, _model.Password, ReturnUrl);
        if (error != null)
        {
            _errorMessage = error;
            _loading = false;
        }
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
