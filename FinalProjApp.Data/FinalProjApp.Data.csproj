<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The database: EF Core context, data services and account checks. Used by
    FinalProjApp.Web. SQL Server: LocalDB on this computer, Azure SQL when hosted.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FinalProjApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Newer than the version the SQL Server driver brings in, which has known vulnerabilities -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinalProjApp.Shared\FinalProjApp.Shared.csproj" />
  </ItemGroup>

</Project>
