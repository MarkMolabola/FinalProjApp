<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The database: EF Core context, data services and account checks. Used by
    FinalProjApp.Web (and by the phone app until it switches to the web API).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FinalProjApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <!-- Newer than the version EF Core brings in, which has a known SQLite vulnerability (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinalProjApp.Shared\FinalProjApp.Shared.csproj" />
  </ItemGroup>

</Project>
