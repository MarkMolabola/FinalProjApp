@page "/login"
@layout Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject FinalProjApp.Services.AuthService AuthService
@inject FinalProjApp.Services.CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="login-card">
    <NavLink href="/" class="back-link" Match="NavLinkMatch.All">
        <i class="bi bi-arrow-left"></i> Back to home
    </NavLink>

    <div class="login-header">
        <div class="brand-mark">🧸</div>
        <h2>Caly Bear Child Care</h2>
        <p>Welcome back! Sign in to continue.</p>
    </div>

    <EditForm Model="@_model" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-emoji-frown-fill"></i>@_errorMessage
            </div>
        }

        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="_model.Email" class="form-control" placeholder="you@example.com" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <InputText @bind-Value="_model.Password" class="form-control" type="password" placeholder="Your password" />
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Sign in
        </button>
    </EditForm>
</div>

@code {
    private LoginModel _model = new();
    private string _errorMessage = "";
    private bool _loading = false;

    protected override void OnInitialized()
    {
        // If already logged in, skip login page
        var user = AuthStateProvider.GetCurrentUserInfo();
        if (user != null)
            RedirectByRole(user.Role);
    }

    private async Task HandleLogin()
    {
        _errorMessage = "";
        _loading = true;

        var user = await AuthService.LoginAsync(_model.Email, _model.Password);
        if (user == null)
        {
            _errorMessage = "That email and password don't match.";
            _loading = false;
            return;
        }

        AuthStateProvider.NotifyUserLoggedIn(user);
        RedirectByRole(user.Role);
    }

    private void RedirectByRole(string role)
    {
        if (role == "Parent")
            Nav.NavigateTo("/parent-portal");
        else
            Nav.NavigateTo("/");
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
