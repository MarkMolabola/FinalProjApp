<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:FinalProjApp.Components;assembly=FinalProjApp.Shared"
             x:Class="FinalProjApp.MainPage"
             BackgroundColor="White"
             SafeAreaEdges="All">

    <!-- SafeAreaEdges keeps the web content out from under the status / nav bars on edge-to-edge Android -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
